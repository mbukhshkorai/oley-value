# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/valupro?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rentcast API
RENTCAST_API_KEY=15a824dd8382447083dc6f93fb169255

# Geoapify API
GEOAPIFY_API_KEY=your-geoapify-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_FREE_PLAN_PRICE_ID=your-free-plan-price-id
STRIPE_PRO_PLAN_PRICE_ID=your-pro-plan-price-id

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=valupro-uploads

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
SYSTEM_EMAIL_FROM=noreply@valupro.com

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
